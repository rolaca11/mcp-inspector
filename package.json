{
  "name": "@rolaca11/mcp-inspector-root",
  "version": "1.0.0-RC4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:cli && bun run build:web",
    "build:cli": "bun run --filter @rolaca11/mcp-inspector build",
    "build:web": "bun run --filter @rolaca11/mcp-inspector-web build",
    "dev:cli": "bun run --filter @rolaca11/mcp-inspector dev",
    "dev:ui": "bun run --filter @rolaca11/mcp-inspector-web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "clean": "rm -rf packages/*/dist"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
