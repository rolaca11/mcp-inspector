{
  "name": "@rolaca11/mcp-inspector-vitest",
  "version": "1.3.2",
  "description": "Vitest primitives and matchers for testing MCP (Model Context Protocol) servers.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rolaca11/mcp-inspector.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vitest",
    "testing",
    "matchers",
    "fixtures"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./setup": "./src/setup.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup && node ../../scripts/write-dist-pkg.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rolaca11/mcp-inspector-core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  }
}
